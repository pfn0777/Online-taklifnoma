[Unit]
Description=Taklifnoma API
After=network.target

[Service]
Type=simple
User=taklifnoma
WorkingDirectory=/opt/taklifnoma/server
EnvironmentFile=/opt/taklifnoma/server/.env
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/taklifnoma/server /var/backups/taklifnoma
PrivateTmp=true

[Install]
WantedBy=multi-user.target
