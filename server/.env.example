# Copy to .env (never commit .env)
PORT=3100
DB_FILE=taklifnoma.db

# node scripts/hash-password.js "your password"
ADMIN_PASSWORD_HASH=

# openssl rand -hex 32
TOKEN_SECRET=

# Vercel site origin(s), comma separated, no trailing slash
ALLOWED_ORIGIN=https://your-site.vercel.app

# 1 when behind Caddy (uses X-Forwarded-For for rate limiting)
TRUST_PROXY=1
